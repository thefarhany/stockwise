JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- PLACEHOLDER OLLAMA (opsional; tanpa OLLAMA_MODEL insight memakai teks template) ---
OLLAMA_URL=http://localhost:11434
# isi dengan nama model yang sudah di-pull, mis. hasil `ollama list`
OLLAMA_MODEL=
# hanya bila Ollama-mu meminta kunci (cloud/proxy); Ollama lokal tidak perlu
OLLAMA_API_KEY=

# --- MAPBOX (opsional; tanpa token, pencarian alamat di Settings tidak tersedia) ---
# Token publik (pk.…) dari https://console.mapbox.com/account/access-tokens/
MAPBOX_ACCESS_TOKEN=
