# Salin ke .env lalu isi. Buat nilai acak: openssl rand -base64 48
DB_PASSWORD=
DB_ROOT_PASSWORD=
# minimal 32 karakter
JWT_SECRET=

# Port frontend di host. Default hanya 127.0.0.1:3000 (untuk reverse proxy/tunnel di mesin yang sama).
# APP_PORT=127.0.0.1:3000

# Opsional; kosong = insight memakai teks template
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Opsional; kosong = pencarian alamat di Pengaturan tidak tersedia
MAPBOX_ACCESS_TOKEN=
